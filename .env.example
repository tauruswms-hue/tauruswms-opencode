# ================================================================================
# Taurus WMS — Variables de entorno (copiar a .env y ajustar)
# .env NO se versiona. Este archivo (.env.example) es la referencia.
# ================================================================================

# Entorno: development | production
# En production se bloquea el arranque si se detectan passwords/secrets por
# defecto (Admin@2024!, Taurus_2001, secret keys de dev) o si falta el archivo
# de conexiones.
APP_ENV=development

# -------------------------------------------------------------------------------
# Bases de datos
# Las conexiones a taurus_admin, taurus_wms y taurus_intercambio NO van acá:
# se definen en conexiones.json, en la raíz del proyecto.
# Para usar un archivo en otra ubicación, indicar su ruta:
# -------------------------------------------------------------------------------
# TAURUS_CONEXIONES=C:\taurus\conexiones.json

# Cada cuántos segundos se relee el archivo de conexiones (default 30)
# CONFIG_CACHE_TTL=30

# -------------------------------------------------------------------------------
# Secretos de sesión
# En producción generar valores aleatorios largos, p. ej.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -------------------------------------------------------------------------------
SECRET_KEY=cambiar_en_produccion
ADMIN_SECRET_KEY=cambiar_en_produccion
SECRET_SALT=cambiar_en_produccion
