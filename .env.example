# ================================================================================
# Taurus WMS — Variables de entorno (copiar a .env y ajustar)
# .env NO se versiona. Este archivo (.env.example) es la referencia.
# ================================================================================

# Entorno: development | production
# En production se bloquea el arranque si se detectan passwords/secrets por
# defecto (Admin@2024!, Taurus_2001, secret keys de dev).
APP_ENV=development

# -------------------------------------------------------------------------------
# Base de datos administrativa (taurus_admin): usuarios, tenants, configuracion
# -------------------------------------------------------------------------------
DB_ADMIN_ENGINE=mysql            # mysql | postgresql | sqlite | sqlserver
DB_ADMIN_HOST=localhost
DB_ADMIN_PORT=3306
DB_ADMIN_NAME=taurus_admin
DB_ADMIN_USER=taurus_admin
DB_ADMIN_PASSWORD=cambiar_en_produccion

# -------------------------------------------------------------------------------
# Base de datos WMS (taurus_wms)
# OJO: la config real se lee de la tabla `configuracion` de taurus_admin.
# Estas variables son SOLO fallback si la tabla no tiene valores.
# -------------------------------------------------------------------------------
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taurus_wms
DB_USER=taurus
DB_PASSWORD=cambiar_en_produccion
DB_CHARSET=utf8mb4

# -------------------------------------------------------------------------------
# Base de datos de intercambio (taurus_intercambio)
# OJO: la config real se lee de la tabla `configuracion` (claves INTERCAMBIO_*).
# Estas variables son SOLO fallback. Postgres necesita psycopg2 y SQL Server
# pymssql (ver requirements.txt).
# -------------------------------------------------------------------------------
DB_INTERCAMBIO_ENGINE=mysql
DB_INTERCAMBIO_HOST=localhost
DB_INTERCAMBIO_PORT=3306
DB_INTERCAMBIO_NAME=taurus_intercambio
DB_INTERCAMBIO_USER=taurus
DB_INTERCAMBIO_PASSWORD=cambiar_en_produccion
DB_INTERCAMBIO_CHAR_SET=utf8mb4

# -------------------------------------------------------------------------------
# Secretos de sesión
# En producción generar valores aleatorios largos, p. ej.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -------------------------------------------------------------------------------
SECRET_KEY=cambiar_en_produccion
ADMIN_SECRET_KEY=cambiar_en_produccion
SECRET_SALT=cambiar_en_produccion
